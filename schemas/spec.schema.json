  "required": [
    "schema_version",
    "project",
    "brief",
    "render",
    "budget",
    "cup",
    "liquid",
    "lighting",
    "stage",
    "animation",
    "cameras"
  ],
  "title": "CG Studio scene specification",
  "type": "object"
}
