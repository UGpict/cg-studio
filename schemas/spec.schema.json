        "cloudiness": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "fill_height": {
          "maximum": 10,
          "minimum": 0.01,
          "type": "number"
        },
        "ior": {
          "maximum": 2.5,
          "minimum": 1,
          "type": "number"
        },
        "meniscus_height": {
          "maximum": 0.2,
          "minimum": 0,
          "type": "number"
        },
        "roughness": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "stream_radius": {
          "maximum": 0.3,
          "minimum": 0.005,
          "type": "number"
        },
        "stream_top": {
          "maximum": 20,
          "minimum": 0.1,
          "type": "number"
        },
        "transmission": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "fill_height",
        "roughness",
        "ior",
        "transmission",
        "absorption_density",
        "absorption_color",
        "cloudiness",
        "meniscus_height",
        "stream_radius",
        "stream_top"
      ],
      "type": "object"
    },
    "project": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "render": {
      "additionalProperties": false,
      "properties": {
        "denoise": {
          "type": "boolean"
        },
        "device": {
          "const": "CPU",
          "type": "string"
        },
        "engine": {
          "const": "CYCLES",
          "type": "string"
        },
        "height": {
          "maximum": 2048,
          "minimum": 64,
          "type": "integer"
        },
        "samples": {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "seed": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "transparent": {
          "type": "boolean"
        },
        "width": {
          "maximum": 2048,
          "minimum": 64,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "samples",
        "seed",
        "engine",
        "device",
        "denoise",
        "transparent"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "stage": {
      "additionalProperties": false,
      "properties": {
        "card_value": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "card_width": {
          "maximum": 3,
          "minimum": 0.1,
          "type": "number"
        },
        "ground_value": {
          "maximum": 2,
          "minimum": 0.05,
          "type": "number"
        }
      },
      "required": [
        "card_value",
        "card_width",
        "ground_value"
      ],
      "type": "object"
    }
